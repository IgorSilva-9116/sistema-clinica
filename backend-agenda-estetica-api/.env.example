# Copie para .env e preencha. NUNCA commite o .env.
NODE_ENV=development
PORT=3000

# =========================
# BANCO
# =========================
# Local:  DB_SERVER=127.0.0.1   DB_ENCRYPT=false
# Azure:  DB_SERVER=<servidor>.database.windows.net   DB_ENCRYPT=true
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=AgendaEstetica
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false

# =========================
# AUTENTICAÇÃO
# =========================
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=5h

# =========================
# CORS (separado por vírgula)
# =========================
CORS_ORIGINS=http://localhost:5173

# =========================
# SMTP
# =========================
# Dev (MailHog): host localhost, porta 1025, sem usuário
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=clinica@exemplo.com

APP_NAME=Estética
APP_URL=http://localhost:5173
RESET_PASSWORD_PATH=/resetar-senha

# Pasta das fotos (no Azure: /home/uploads)
UPLOAD_DIR=
